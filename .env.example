# ============================================================
#  MAKASI AI — Variables d'environnement (Vercel)
#  Ne JAMAIS commiter vos vraies clés ici.
# ============================================================

# --- Clé(s) du moteur d’IA (côté serveur uniquement) ---
# Le nom technique GEMINI_API_KEY est conservé pour compatibilité.
GEMINI_API_KEY=votre_cle_serveur_ici

# Facultatif : clés de secours pour répartir la charge.
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=

# --- Comptes web + mémoire partagée (Supabase, optionnel) ---
# Supabase > Project Settings > API
# L'URL et la clé "anon" sont publiques : elles sont servies par /api/config.
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_ANON_KEY=votre_cle_anon_publique

# ------------------------------------------------------------
#  L'application mobile utilise un compte local enregistré sur
#  le téléphone : aucune variable Supabase n'est nécessaire pour
#  l'APK.
# ------------------------------------------------------------
